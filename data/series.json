{
 "_about": "Researched facts for satellite series (mostly Kosmos), keyed by series, with the NORAD ids that belong to each. Membership and facts come from each series' source page (Gunter's Space Page, checked 2026-09-30). Keep every fact true. A series can list several true facts ('facts'); each satellite shows one, chosen by its NORAD id.",
 "series": {
  "strela-1": {
   "name": "Strela-1",
   "fact": "A prototype of the Soviet **Strela** military message relay: it recorded messages as it passed over one place and played them back over another.",
   "source": "https://space.skyrocket.de/doc_sdat/strela-1.htm"
  },
  "strela-1m": {
   "name": "Strela-1M",
   "source": "https://space.skyrocket.de/doc_sdat/strela-1m.htm",
   "facts": [
    "A Strela-1M military **message relay**, launched **eight at a time** on one rocket. Each weighed only about 70 kg and was built to last about six months.",
    "Strela-1M satellites were left to **drift freely** around their orbit, so over time they spread out evenly around the planet.",
    "Each Strela-1M only lasted about six months, so the network was **topped up once or twice a year** with a fresh batch of eight."
   ]
  },
  "strela-2m": {
   "name": "Strela-2M",
   "source": "https://space.skyrocket.de/doc_sdat/strela-2m.htm",
   "facts": [
    "A Strela-2M military **message relay**: it recorded messages over one part of the world and played them back over another. Another of these, Kosmos 2251, was destroyed in the first-ever crash between two satellites.",
    "52 Strela-2M satellites were launched to about **800 km up**, and three of them never reached orbit."
   ]
  },
  "strela-3": {
   "name": "Strela-3",
   "source": "https://space.skyrocket.de/doc_sdat/strela-3.htm",
   "facts": [
    "A Strela-3 military **message relay**, launched **six at a time** on a Tsyklon-3 rocket. Twelve of them, in two orbital planes, made up the working network.",
    "Each Strela-3 had a long **boom** that let gravity keep it pointed at Earth, with no fuel needed.",
    "It could hold about **12 megabits** of messages at a time, about one and a half megabytes."
   ]
  },
  "strela-3m": {
   "name": "Strela-3M (Rodnik-S)",
   "fact": "A Strela-3M **store-and-forward** satellite: it records messages as it passes over one ground station and delivers them over another, which helps in remote places with no other links.",
   "source": "https://space.skyrocket.de/doc_sdat/strela-3m.htm"
  },
  "parus": {
   "name": "Parus",
   "source": [
    "https://space.skyrocket.de/doc_sdat/parus.htm",
    "https://space.skyrocket.de/doc_sdat/tsikada.htm"
   ],
   "facts": [
    "A Parus satellite of the Soviet military **navigation** system Tsiklon-B. It reportedly also relayed data from Soviet ocean-surveillance satellites.",
    "Nearly **100 Parus satellites** were launched, from 1974 to 2010, all from Plesetsk.",
    "Like its civilian twin Tsikada, a Parus satellite used **gravity**, not fuel, to keep one side pointed at Earth."
   ]
  },
  "tsikada": {
   "name": "Tsikada",
   "fact": "Tsikada was a Soviet **civilian navigation** system: merchant ships worked out where they were from the radio signals of satellites like this one.",
   "source": "https://space.skyrocket.de/doc_sdat/tsikada.htm"
  },
  "nadezhda": {
   "name": "Nadezhda",
   "fact": "A Nadezhda navigation satellite that also carried a **COSPAS search-and-rescue** receiver, listening for distress beacons from ships and planes.",
   "source": "https://space.skyrocket.de/doc_sdat/nadezhda.htm"
  },
  "us-a": {
   "name": "US-A (RORSAT)",
   "fact": "Part of a Soviet radar **spy satellite** that watched ships at sea, powered by a **nuclear reactor**. At the end of each mission the reactor was boosted up to a higher storage orbit. Another one, Kosmos 954, fell on Canada in 1978.",
   "source": "https://space.skyrocket.de/doc_sdat/us-a.htm"
  },
  "us-ao": {
   "name": "US-AO",
   "fact": "An early test flight for the Soviet **radar ocean-surveillance** programme (US-A), flown before the nuclear-powered satellites went into service in 1970.",
   "source": "https://space.skyrocket.de/doc_sdat/us-ao.htm"
  },
  "ds-p1-m": {
   "name": "DS-P1-M (Lira)",
   "fact": "An armoured **target** for Soviet anti-satellite tests. Interceptors flew up to explode near it while sensors on board recorded the shrapnel hits. It was built to survive up to three attacks.",
   "source": "https://space.skyrocket.de/doc_sdat/ds-p1-m.htm"
  },
  "is-a": {
   "name": "IS-A",
   "fact": "One of the Soviet Union's **anti-satellite interceptors**. It was built to match a target satellite's orbit, close in and destroy it.",
   "source": "https://space.skyrocket.de/doc_sdat/is-a.htm"
  },
  "i2p": {
   "name": "I2P",
   "fact": "From the Soviet Union's first **anti-satellite interceptor** tests, in 1968 to 1971. The interceptors were built to catch up with a target satellite and destroy it.",
   "source": "https://space.skyrocket.de/doc_sdat/i2p.htm"
  },
  "geo-ik": {
   "name": "Geo-IK (Musson)",
   "fact": "A Geo-IK **geodesy** satellite, used to pin down exact positions on Earth's surface for accurate maps and to study the shape of the ocean surface.",
   "source": "https://space.skyrocket.de/doc_sdat/geo-ik.htm"
  },
  "sfera": {
   "name": "Sfera",
   "fact": "One of the first Soviet **mapping** satellites. It flashed bright lights so it could be photographed against the stars, letting mapmakers fix faraway points to within about 30 metres.",
   "source": "https://space.skyrocket.de/doc_sdat/sfera.htm"
  },
  "tselina-d": {
   "name": "Tselina-D",
   "fact": "A Tselina-D **eavesdropping** satellite: it recorded signals from radars and radio transmitters below and played them back to ground stations in the USSR.",
   "source": "https://space.skyrocket.de/doc_sdat/tselina-d.htm"
  },
  "tselina-2": {
   "name": "Tselina-2",
   "fact": "A Tselina-2 **eavesdropping** satellite: it listened for military radars and radio transmitters and worked out where on the ground they were.",
   "source": "https://space.skyrocket.de/doc_sdat/tselina-2.htm"
  },
  "taifun-1": {
   "name": "Taifun-1 (Vektor)",
   "fact": "A 2-metre **ball** covered in solar cells, used as a target to calibrate Soviet and Russian radars.",
   "source": "https://space.skyrocket.de/doc_sdat/taifun-1.htm"
  },
  "bars-m": {
   "name": "Bars-M",
   "fact": "A Bars-M **mapping camera** satellite, which reportedly takes detailed 3D pictures of the ground and measures heights with lasers.",
   "source": "https://space.skyrocket.de/doc_sdat/bars-m.htm"
  },
  "lotos-s": {
   "name": "Lotos-S",
   "fact": "A Lotos-S **eavesdropping** satellite, part of Russia's newer Liana system, which replaced the Tselina-2 satellites.",
   "source": "https://space.skyrocket.de/doc_sdat/lotos-s.htm"
  },
  "persona": {
   "name": "Persona",
   "fact": "A Persona **spy camera** satellite. Its optics were reportedly built from parts made for a cancelled space telescope with a 1.5-metre mirror.",
   "source": "https://space.skyrocket.de/doc_sdat/persona.htm"
  },
  "strela-3-late": {
   "name": "Strela-3",
   "fact": "A Strela-3 military **message relay**. Once the Tsyklon-3 rocket retired in 2002, these went up two or three at a time on smaller rockets.",
   "source": "https://space.skyrocket.de/doc_sdat/strela-3.htm"
  },
  "us-a-core": {
   "name": "US-A (RORSAT)",
   "source": "https://space.skyrocket.de/doc_sdat/us-a.htm",
   "facts": [
    "Part of a Soviet radar **spy satellite** that watched ships at sea, powered by a **nuclear reactor**. At the end of each mission the reactor was boosted up to a higher storage orbit. Another one, Kosmos 954, fell on Canada in 1978.",
    "Satellites like this one could throw their reactor core clear, so that if it ever fell, the radioactive core would burn up instead of reaching the ground."
   ]
  }
 },
